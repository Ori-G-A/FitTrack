{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "FitTrack",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "FitTrackDesktop",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "--directory",
        "desktop"
      ],
      "port": 4180,
      "autoPort": false
    },
    {
      "name": "FitTrackProd",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173,
      "autoPort": false
    }
  ]
}
